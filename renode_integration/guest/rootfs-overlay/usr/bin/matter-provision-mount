#!/bin/sh
# Mount matter-provision.ext2 after Renode loads it post-checkpoint.
set -eu

MARKER="tool/provision.py"
DEST="/root/matter-provision"
# provision_virtio is the second virtio block device -> vdb.
PROVISION_DEV=/dev/vdb

if mountpoint -q "$DEST" 2>/dev/null; then
    if [ -e "$DEST/$MARKER" ]; then
        echo "matter-provision-mount: already mounted at $DEST"
        exit 0
    fi
fi

if [ ! -b "$PROVISION_DEV" ]; then
    echo "matter-provision-mount: $PROVISION_DEV not present" >&2
    exit 1
fi

size=$(cat /sys/block/vdb/size 2>/dev/null) || size=0
if [ "$size" -le 0 ] 2>/dev/null; then
    if ! echo 1 > "/sys/block/vdb/device/rescan" 2>/dev/null; then
        echo "matter-provision-mount: rescan failed and $PROVISION_DEV has no size" >&2
        echo "Load matter-provision.ext2 on provision_virtio, then retry." >&2
        exit 1
    fi
    size=$(cat /sys/block/vdb/size 2>/dev/null) || size=0
fi
if [ "$size" -le 0 ] 2>/dev/null; then
    echo "matter-provision-mount: $PROVISION_DEV has no image (size 0)" >&2
    echo "Load matter-provision.ext2 on provision_virtio, then retry." >&2
    exit 1
fi

mkdir -p "$DEST"
if ! mount -o ro "$PROVISION_DEV" "$DEST"; then
    echo "matter-provision-mount: mount $PROVISION_DEV failed" >&2
    exit 1
fi
if [ ! -e "$DEST/$MARKER" ]; then
    umount "$DEST"
    echo "matter-provision-mount: $PROVISION_DEV is not a provision image (missing $MARKER)" >&2
    exit 1
fi

echo "matter-provision-mount: mounted $PROVISION_DEV at $DEST"
exit 0
