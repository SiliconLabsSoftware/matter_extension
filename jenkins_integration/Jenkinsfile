#!groovy
@Library('gsdk-shared-lib@master')

def pipelineProperties = []

// Configure pollSCM triggers
if(env.BRANCH_NAME == 'main'){
    // Trigger Thursday at 10:05pm EDT (2 hrs after github trigger)
    pipelineProperties << pipelineTriggers([pollSCM('5 2 * * 5')])
}

properties(pipelineProperties)

def build_description = ""

pipeline
{
    agent { node { label 'Build-Farm-Large' } }
    options { buildDiscarder(logRotator(artifactNumToKeepStr: '10')) }
    stages {
        stage('Upload Artifacts') {
            steps {
                script {
                    pipelineFunctions = load 'jenkins_integration/jenkinsFunctions.groovy'
                    echo "pipelineFunctions loaded: ${pipelineFunctions != null}"

                    // Resolve outside ubai docker: SLT/Conan list+1 for shared package version (.N).
                    def packageVersion = pipelineFunctions.resolvePackageVersion()
                    build_description = "Package version: ${packageVersion}"
                    buildDescription(build_description)
                }
            }
        }
    }
}
