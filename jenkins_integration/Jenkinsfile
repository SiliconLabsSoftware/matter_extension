#!groovy
@Library('gsdk-shared-lib@master')

// svc_matter credential ID.
def sonarqubeTokenCredentialId = 'sonarqube_token'

pipeline
{
    agent { node { label 'Build-Farm-Large' } }
    options { buildDiscarder(logRotator(artifactNumToKeepStr: '10')) }
    stages {
        stage('Coverage and Code Size') {
            steps {
                script {
                    if (!fileExists('coverage/sonarqube-coverage.xml')) {
                        error('[FAIL] coverage/sonarqube-coverage.xml missing at repo root. Commit it before running this test branch.')
                    }
                    sh 'git submodule update --init third_party/matter_sdk'
                    withCredentials([string(credentialsId: sonarqubeTokenCredentialId, variable: 'SONAR_TOKEN')]) {
                        sh '''
                            docker run --rm \
                                -e SONAR_HOST_URL="https://sonarqube.silabs.net" \
                                -e SONAR_TOKEN="$SONAR_TOKEN" \
                                -v "$WORKSPACE:/usr/src" \
                                sonarsource/sonar-scanner-cli:11 \
                                -Dsonar.scm.disabled=true \
                                -Dsonar.coverageReportPaths=coverage/sonarqube-coverage.xml
                        '''
                    }
                }
            }
        }
    }
}
