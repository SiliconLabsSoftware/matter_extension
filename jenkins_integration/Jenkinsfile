#!groovy
@Library('gsdk-shared-lib@master')

def pipelineProperties = []

// Configure pollSCM triggers
if(env.BRANCH_NAME == 'main'){
    // Trigger Thursday at 10:05pm EDT (2 hrs after github trigger)
    pipelineProperties << pipelineTriggers([pollSCM('5 2 * * 5')])
} 

properties(pipelineProperties)

def commit_sha = ""
def run_number = ""
def workflow_id = ""
def pr_number = ""
def bypass_send_results_gh = ""
def build_description = ""
def commit_change_summary = ""

// svc_matter credential ID.
def sonarqubeTokenCredentialId = 'sonarqube_token'

def combineSlackSummary(String commitSummary, String extra) {
    def c = commitSummary?.trim() ?: ''
    def e = extra?.trim() ?: ''
    if (c && e) {
        return "${c}\n\n---\n\n${e}"
    }
    return c ?: e ?: ''
}

def sendSlackNotification(String messageType, String status, String summary = "", String color = "", String commitSha = "", String runNumber = "", String workflowId = "") {
    def currentTime = new Date().format("yyyy-MM-dd HH:mm:ss", TimeZone.getTimeZone('UTC'))
    def statusEmoji = status == "PASS" ? "✅" : "❌"
    def alertEmoji = status == "PASS" ? "🎉" : "🚨"
    
    def notificationColor = color ?: (status == "PASS" ? "good" : "danger")
    def reportedCommitSha = env.GIT_COMMIT ?: commitSha
    
    def message = """${alertEmoji} *${messageType.toUpperCase()}* ${alertEmoji}
                    
*Repository:* Matter Extension
*Branch:* `${env.BRANCH_NAME}`
*Build Number:* #${env.BUILD_NUMBER}
*Status:* ${statusEmoji} ${status}
*Timestamp:* ${currentTime} UTC

📋 *Details:*"""
    
    if (reportedCommitSha) {
        message += "\n• *Commit SHA:* `${reportedCommitSha}`"
    }
    if (runNumber) {
        message += "\n• *GitHub Workflow Run:* #${runNumber}"
    }
    if (workflowId) {
        message += "\n• *Workflow ID:* ${workflowId}"
    }
    
    if (summary && summary.trim()) {
        message += "\n\n📊 *Summary:*\n${summary}"
    }
    
    message += "\n\n🔗 *Links:*"
    message += "\n• <${env.BUILD_URL}|Jenkins Build>"
    message += "\n• <${env.BUILD_URL}console|Console Output>"
    
    if (reportedCommitSha) {
        message += "\n• <https://github.com/SiliconLabsSoftware/matter_extension/commit/${reportedCommitSha}|GitHub Commit>"
    }
    
    if (status == "FAIL") {
        message += "\n\n⚠️ *Action Required:* Please investigate and resolve the issue."
    }
    
    slackSend(channel: 'matter-release-build-notifications',
              color: notificationColor,
              message: message)
}

pipeline
{
    agent { node { label 'Build-Farm-Large' } }
    options { buildDiscarder(logRotator(artifactNumToKeepStr: '10')) }
    stages {
        stage('Initialize') {
            steps {
                script {
                    pipelineFunctions = load 'jenkins_integration/jenkinsFunctions.groovy'
                    echo "pipelineFunctions loaded: ${pipelineFunctions != null}"
                    sisdk_build_number = sh(script: "git config -f .gitmodules --get submodule.third_party/simplicity_sdk.tag | sed 's/.*-//'", returnStdout: true).trim()
                    wiseconnect_build_number = sh(script: "git config -f .gitmodules --get submodule.third_party/wifi_sdk.tag | sed 's/.*-//'", returnStdout: true).trim()
                    build_description = "SISDK build number: ${sisdk_build_number}"
                    build_description += "\nWiFi Extension build number: ${wiseconnect_build_number}"
                    buildDescription(build_description)
                    commit_change_summary = pipelineFunctions.buildCommitChangeSummaryForSlack()
                                    }
            }
        }
        stage('Upload Artifacts') {
            steps {
                script {
                    // Resolve outside ubai docker: release path needs SLT/Conan for remote +1.
                    def packageVersion = pipelineFunctions.resolvePackageVersion()
                    build_description += "\nPackage version: ${packageVersion}"
                    buildDescription(build_description)

                    retry(9) {
                        withDockerContainer(image: 'artifactory.silabs.net/gsdk-docker-production/gsdk_nomad_containers/gsdk_ubai:latest') {
                            pipelineFunctions.actionWithRetry {
                                def result = pipelineFunctions.upload_artifacts()
                                commit_sha = result.commit_sha
                                run_number = result.run_number
                                workflow_id = result.workflow_id
                                bypass_send_results_gh = result.bypass_send_results
                                pr_number = result.pr_number
                                echo "commit_sha: ${commit_sha}, run_number: ${run_number}, workflow_id: ${workflow_id}"
                                build_description += "\nGitHub Workflow Run Number: ${run_number}"
                                buildDescription(build_description)

                                try{
                                    pipelineFunctions.upload_zephyr_artifacts()
                                } catch (e) {
                                    unstable("Zephyr artifact upload to UBAI failed: ${e.message}")
                                }
                            }
                        }
                    }
                }
            }
        }
        stage('Coverage and Code Size') {
            when {
                expression { env.BRANCH_NAME == "main" || env.BRANCH_NAME.startsWith("release_") }
            }
            parallel {
                stage('Code Coverage & Static Code Analysis') {
                    when {
                        expression { env.BRANCH_NAME == "main" }
                    }
                    steps {
                        script {
                            withDockerContainer(image: 'artifactory.silabs.net/gsdk-docker-production/gsdk_nomad_containers/gsdk_ubai:latest') {
                                pipelineFunctions.actionWithRetry {
                                    pipelineFunctions.download_coverage_artifact(workflow_id)
                                }
                                sh '''
                                    if [ -f coverage/coverage.info ]; then
                                        echo "[SUCCESS] GitHub LCOV coverage artifact downloaded to ./coverage"
                                        ls -la coverage/
                                        if [ -f coverage/sonarqube-coverage.xml ]; then
                                            echo "[SUCCESS] sonarqube-coverage.xml present (from GitHub Actions)"
                                        else
                                            echo "[WARN] sonarqube-coverage.xml missing; run a workflow that includes the gcovr step in coverage-builder.yaml"
                                        fi
                                    fi
                                '''
                                archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true, fingerprint: false
                            }
                            if (fileExists('coverage/sonarqube-coverage.xml')) {
                                withCredentials([string(credentialsId: sonarqubeTokenCredentialId, variable: 'SONAR_TOKEN')]) {
                                    sh '''
                                        docker run --rm \
                                            -e SONAR_HOST_URL="https://sonarqube.silabs.net" \
                                            -e SONAR_TOKEN="$SONAR_TOKEN" \
                                            -v "$WORKSPACE:/usr/src" \
                                            sonarsource/sonar-scanner-cli:11 \
                                            -Dsonar.scm.disabled=true \
                                            -Dsonar.coverageReportPaths=coverage/sonarqube-coverage.xml
                                    '''
                                }
                            } else {
                                echo '[SKIP] No coverage/sonarqube-coverage.xml; skipping SonarQube analysis.'
                            }
                        }
                    }
                }
                stage('Code Size Analysis') {
                    steps {
                        script {
                            withDockerContainer(image: 'artifactory.silabs.net/gsdk-docker-production/gsdk_nomad_containers/gsdk_ubai:latest') {
                                pipelineFunctions.run_code_size_analysis()
                            }
                        }
                    }
                }
            }
        }
        stage('Execute CI Tests')
        {
            steps {
                script {
                    def parallelNodes = [:]
                    if (pr_number != null) {
                        branch_name = "PR-${pr_number}"
                    } else {
                        branch_name = env.BRANCH_NAME
                    }
                    parallelNodes['MG24 Lighting-App'] = {
                        pipelineFunctions.actionWithRetry {
                            failed_tests_mg24 = pipelineFunctions.execute_sanity_tests(
                                'gsdkMontrealNode','utf-matter-thread-4187c-ci',
                                '3251', 'lighting-app','thread','BRD4187C',"",
                                branch_name, env.BUILD_NUMBER)
                        }
                    }
                    parallelNodes['SIWX Lighting-App'] = {
                        pipelineFunctions.actionWithRetry {
                            failed_tests_917 = pipelineFunctions.execute_sanity_tests(
                                'gsdkMontrealNode','utf-matter-wifi-917soc-4338a-ci', '3249',
                                'lighting-app','wifi','BRD4338A','917_soc', branch_name, env.BUILD_NUMBER)
                        }
                    }
//                     Temp comment out due to SQA setup issues
//                     parallelNodes['SiMG301 Lighting-App'] = {
//                         pipelineFunctions.actionWithRetry {
//                             failed_tests_4407a = pipelineFunctions.execute_sanity_tests(
//                                 'gsdkMontrealNode','utf-matter-thread-4407a-ci',
//                                 '4878', 'lighting-app','thread','BRD4407A',"",
//                                 branch_name, env.BUILD_NUMBER)
//                         }
//                     }

                    parallelNodes.failFast = false
                    parallel parallelNodes

                    def totalFailedTests = 0
                    def failedTestsSummary = []

                    if (failed_tests_mg24 && failed_tests_mg24.failedCount > 0) {
                        totalFailedTests += failed_tests_mg24.failedCount
                        failedTestsSummary << "MG24: ${failed_tests_mg24.failedCount} failed tests - ${failed_tests_mg24.failedTests.join(', ')}"
                    }

                    if (failed_tests_917 && failed_tests_917.failedCount > 0) {
                        totalFailedTests += failed_tests_917.failedCount
                        failedTestsSummary << "917: ${failed_tests_917.failedCount} failed tests - ${failed_tests_917.failedTests.join(', ')}"
                    }

//                     Temp comment out due to SQA setup issues
//                     if (failed_tests_4407a && failed_tests_4407a.failedCount > 0) {
//                         totalFailedTests += failed_tests_4407a.failedCount
//                         failedTestsSummary << "SiMG301: ${failed_tests_4407a.failedCount} failed tests - ${failed_tests_4407a.failedTests.join(', ')}"
//                     }

                    def sqa_tests_result = totalFailedTests > 0 ? "FAIL" : "PASS"
                    def sqa_tests_summary = failedTestsSummary.isEmpty() ? "All tests passed successfully." : failedTestsSummary.join('\n')

                    echo "SQA Tests Result: ${sqa_tests_result}"
                    echo "SQA Tests Summary:\n${sqa_tests_summary}"

                    echo "commit_sha: ${commit_sha}"
                    if (!bypass_send_results_gh){
                        pipelineFunctions.send_test_results_to_github(commit_sha, sqa_tests_result, sqa_tests_summary)
                    }
                    if (env.BRANCH_NAME.startsWith("main") || env.BRANCH_NAME.startsWith("release_")) {
                        if (sqa_tests_result == "FAIL") {
                            sendSlackNotification("SQA Tests Failed", "FAIL", combineSlackSummary(commit_change_summary, sqa_tests_summary), "", commit_sha, run_number, workflow_id)
                            error("[FAIL] Sanity Tests failed. See summary:\n${sqa_tests_summary}")
                        } else {
                            sendSlackNotification("SQA Tests Passed", "PASS", combineSlackSummary(commit_change_summary, "All tests passed successfully."), "", commit_sha, run_number, workflow_id)
                            echo "All tests passed successfully."
                        }
                    }
                }
            }
        }
        stage('Create and Publish Matter Packages') {
            steps {
                script {
                    def isRelease = env.BRANCH_NAME.startsWith('release_')
                    def remoteName = isRelease ? 'silabs-conan-production' : 'matter-conan-dev'
                    def remoteUrl = isRelease
                        ? 'https://artifactory-local.silabs.net/artifactory/api/conan/silabs-conan-production'
                        : 'https://artifactory-local.silabs.net/artifactory/api/conan/matter-conan-dev'
                    def actionDir = "${env.WORKSPACE}/action-conan-create-publish"

                    pipelineFunctions.checkoutGithubActionRepo(
                        'action-conan-create-publish',
                        'https://github.com/SiliconLabsInternal/action-conan-create-publish.git',
                        'refs/tags/v2.5.4'
                    )

                    withCredentials([
                        string(credentialsId: 'artifactory_token', variable: 'ARTIFACTORY_TOKEN')
                    ]) {
                        pipelineFunctions.initMatterPackageSubmodules()
                        pipelineFunctions.setupUv()
                        pipelineFunctions.setupSltAndConan()
                        // Release branches keep packages/.prerelease; others get pr.<n> or the branch name.
                        pipelineFunctions.writePrereleaseLabel()

                        def refs = []
                        [
                            [name: 'matter',     recipe: "${env.WORKSPACE}/packages/matter/conanfile.py"],
                            [name: 'matter_app', recipe: "${env.WORKSPACE}/packages/matter_app/conanfile.py"],
                        ].each { pkg ->
                            pipelineFunctions.runActionConanCreatePublish(
                                pkg.name, pkg.recipe, remoteName, remoteUrl, actionDir
                            )
                            def pkgInfo = pipelineFunctions.readConanPackageOutputJson()
                            def fullRef = pkgInfo.full_package_ref
                            if (!fullRef) {
                                error("full_package_ref missing from conan_package_output.json for ${pkg.name}")
                            }
                            refs << fullRef
                            echo "Captured full_package_ref for ${pkg.name}: ${fullRef}"

                            // Share prerelease number with matter_app so versions match
                            if (!env.SL_PRERELEASE_NUMBER?.trim() && pkgInfo.prerelease_number) {
                                env.SL_PRERELEASE_NUMBER = pkgInfo.prerelease_number.toString()
                                echo "SL_PRERELEASE_NUMBER=${env.SL_PRERELEASE_NUMBER}"
                            }
                        }

                        env.MATTER_PACKAGE_REF = refs.join(' ')
                        env.MATTER_PACKAGE_SOURCE_REMOTE_URL = remoteUrl
                        echo "MATTER_PACKAGE_REF=${env.MATTER_PACKAGE_REF}"
                    }
                }
            }
        }
        stage('Promote Matter Packages to SQA') {
            // SiliconLabsInternal/action-conan-promote@v2 via uv + JFrog CLI
            when {
                expression { env.BRANCH_NAME.startsWith("release_") }
            }
            steps {
                script {
                    def sourceRemoteUrl = env.MATTER_PACKAGE_SOURCE_REMOTE_URL
                    def destRemoteUrl = 'https://artifactory-local.silabs.net/artifactory/api/conan/matter-conan-sqa'
                    def packageRef = env.MATTER_PACKAGE_REF
                    if (!packageRef || !sourceRemoteUrl) {
                        error('MATTER_PACKAGE_REF is empty; create/publish stage must set full package refs')
                    }

                    pipelineFunctions.checkoutGithubActionRepo(
                        'action-conan-promote',
                        'https://github.com/SiliconLabsInternal/action-conan-promote.git',
                        '*/v2'
                    )

                    withCredentials([
                        string(credentialsId: 'artifactory_token', variable: 'ARTIFACTORY_TOKEN')
                    ]) {
                        pipelineFunctions.runActionConanPromote(
                            packageRef,
                            sourceRemoteUrl,
                            destRemoteUrl,
                            "${env.WORKSPACE}/action-conan-promote"
                        )
                    }
                }
            }
        }
    }
    post {
        failure {
            script {
                if ((env.BRANCH_NAME == "main" || env.BRANCH_NAME.startsWith("release_"))) {
                    sendSlackNotification("Pipeline Failure", "FAIL", combineSlackSummary(commit_change_summary, "Pipeline execution failed. Please check the console output for details."), "", "${commit_sha ?: ''}", "${run_number ?: ''}", "${workflow_id ?: ''}")
                }
            }
        }
    }
}