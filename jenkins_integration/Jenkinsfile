#!groovy
@Library('gsdk-shared-lib@master')

def commit_sha = ""
def run_number = ""
def workflow_id = ""
def build_description = ""
def commit_change_summary = ""

// svc_matter credential ID.
def sonarqubeTokenCredentialId = 'sonarqube_token'

def combineSlackSummary(String commitSummary, String extra) {
    def c = commitSummary?.trim() ?: ''
    def e = extra?.trim() ?: ''
    if (c && e) {
        return "${c}\n\n---\n\n${e}"
    }
    return c ?: e ?: ''
}

def sendSlackNotification(String messageType, String status, String summary = "", String color = "", String commitSha = "", String runNumber = "", String workflowId = "") {
    def currentTime = new Date().format("yyyy-MM-dd HH:mm:ss", TimeZone.getTimeZone('UTC'))
    def statusEmoji = status == "PASS" ? "✅" : "❌"
    def alertEmoji = status == "PASS" ? "🎉" : "🚨"
    
    def notificationColor = color ?: (status == "PASS" ? "good" : "danger")
    def reportedCommitSha = env.GIT_COMMIT ?: commitSha
    
    def message = """${alertEmoji} *${messageType.toUpperCase()}* ${alertEmoji}
                    
*Repository:* Matter Extension
*Branch:* `${env.BRANCH_NAME}`
*Build Number:* #${env.BUILD_NUMBER}
*Status:* ${statusEmoji} ${status}
*Timestamp:* ${currentTime} UTC

📋 *Details:*"""
    
    if (reportedCommitSha) {
        message += "\n• *Commit SHA:* `${reportedCommitSha}`"
    }
    if (runNumber) {
        message += "\n• *GitHub Workflow Run:* #${runNumber}"
    }
    if (workflowId) {
        message += "\n• *Workflow ID:* ${workflowId}"
    }
    
    if (summary && summary.trim()) {
        message += "\n\n📊 *Summary:*\n${summary}"
    }
    
    message += "\n\n🔗 *Links:*"
    message += "\n• <${env.BUILD_URL}|Jenkins Build>"
    message += "\n• <${env.BUILD_URL}console|Console Output>"
    
    if (reportedCommitSha) {
        message += "\n• <https://github.com/SiliconLabsSoftware/matter_extension/commit/${reportedCommitSha}|GitHub Commit>"
    }
    
    if (status == "FAIL") {
        message += "\n\n⚠️ *Action Required:* Please investigate and resolve the issue."
    }
    
    slackSend(channel: 'matter-release-build-notifications',
              color: notificationColor,
              message: message)
}

pipeline
{
    agent { node { label 'Build-Farm-Large' } }
    options { buildDiscarder(logRotator(artifactNumToKeepStr: '10')) }
    stages {
        stage('Resolve Coverage Workflow') {
            steps {
                script {
                    pipelineFunctions = load 'jenkins_integration/jenkinsFunctions.groovy'
                    echo "pipelineFunctions loaded: ${pipelineFunctions != null}"
                    commit_change_summary = pipelineFunctions.buildCommitChangeSummaryForSlack()

                    // Coverage-only path: wait for GHA "Build Dev apps" / Build Coverage
                    // artifact (lcov-report-*-coverage). No app binaries / UBAI upload.
                    def result = pipelineFunctions.resolve_coverage_workflow()
                    commit_sha = result.commit_sha
                    run_number = result.run_number
                    workflow_id = result.workflow_id
                    echo "commit_sha: ${commit_sha}, run_number: ${run_number}, workflow_id: ${workflow_id}"
                    build_description = "GitHub Workflow Run Number: ${run_number}\nWorkflow ID: ${workflow_id}"
                    buildDescription(build_description)
                }
            }
        }
        stage('Code Coverage & Static Code Analysis') {
            steps {
                script {
                    withDockerContainer(image: 'artifactory.silabs.net/gsdk-docker-production/gsdk_nomad_containers/gsdk_ubai:latest') {
                        pipelineFunctions.actionWithRetry {
                            pipelineFunctions.download_coverage_artifact(workflow_id)
                        }
                        sh '''
                            if [ -f coverage/coverage.info ]; then
                                echo "[SUCCESS] GitHub LCOV coverage artifact downloaded to ./coverage"
                                ls -la coverage/
                            else
                                echo "[ERROR] coverage.info missing after download" >&2
                                ls -la coverage/ || true
                                exit 1
                            fi
                            if [ -f coverage/sonarqube-coverage.xml ]; then
                                echo "[SUCCESS] sonarqube-coverage.xml present"
                            else
                                echo "[ERROR] sonarqube-coverage.xml missing" >&2
                                exit 1
                            fi
                        '''
                        archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: false, fingerprint: false
                    }
                    withCredentials([string(credentialsId: sonarqubeTokenCredentialId, variable: 'SONAR_TOKEN')]) {
                        sh '''
                            docker run --rm \
                                -e SONAR_HOST_URL="https://sonarqube.silabs.net" \
                                -e SONAR_TOKEN="$SONAR_TOKEN" \
                                -v "$WORKSPACE:/usr/src" \
                                sonarsource/sonar-scanner-cli:11 \
                                -Dsonar.scm.disabled=true \
                                -Dsonar.coverageReportPaths=coverage/sonarqube-coverage.xml
                        '''
                    }
                }
            }
        }
    }
    post {
        failure {
            script {
                if ((env.BRANCH_NAME == "main" || env.BRANCH_NAME.startsWith("release_") || env.BRANCH_NAME.startsWith("test/"))) {
                    sendSlackNotification("Pipeline Failure", "FAIL", combineSlackSummary(commit_change_summary, "Pipeline execution failed. Please check the console output for details."), "", "${commit_sha ?: ''}", "${run_number ?: ''}", "${workflow_id ?: ''}")
                }
            }
        }
    }
}
