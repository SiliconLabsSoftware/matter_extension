#!groovy
@Library('gsdk-shared-lib@master')

def commit_sha = ""
def run_number = ""
def workflow_id = ""
def build_description = ""

// svc_matter credential ID.
def sonarqubeTokenCredentialId = 'sonarqube_token'

pipeline
{
    agent { node { label 'Build-Farm-Large' } }
    options { buildDiscarder(logRotator(artifactNumToKeepStr: '10')) }
    stages {
        stage('Resolve Coverage Workflow') {
            steps {
                script {
                    pipelineFunctions = load 'jenkins_integration/jenkinsFunctions.groovy'
                    echo "pipelineFunctions loaded: ${pipelineFunctions != null}"

                    // Coverage-only path: wait for GHA "Build Dev apps" / Build Coverage
                    // artifact (lcov-report-*-coverage). No app binaries / UBAI upload.
                    def result = pipelineFunctions.resolve_coverage_workflow()
                    commit_sha = result.commit_sha
                    run_number = result.run_number
                    workflow_id = result.workflow_id
                    echo "commit_sha: ${commit_sha}, run_number: ${run_number}, workflow_id: ${workflow_id}"
                    build_description = "GitHub Workflow Run Number: ${run_number}\nWorkflow ID: ${workflow_id}"
                    buildDescription(build_description)
                }
            }
        }
        stage('Code Coverage & Static Code Analysis') {
            steps {
                script {
                    withDockerContainer(image: 'artifactory.silabs.net/gsdk-docker-production/gsdk_nomad_containers/gsdk_ubai:latest') {
                        pipelineFunctions.actionWithRetry {
                            pipelineFunctions.download_coverage_artifact(workflow_id)
                        }
                        sh '''
                            if [ -f coverage/coverage.info ]; then
                                echo "[SUCCESS] GitHub LCOV coverage artifact downloaded to ./coverage"
                                ls -la coverage/
                            else
                                echo "[ERROR] coverage.info missing after download" >&2
                                ls -la coverage/ || true
                                exit 1
                            fi
                            if [ -f coverage/sonarqube-coverage.xml ]; then
                                echo "[SUCCESS] sonarqube-coverage.xml present"
                            else
                                echo "[ERROR] sonarqube-coverage.xml missing" >&2
                                exit 1
                            fi
                        '''
                        archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: false, fingerprint: false
                    }

                    // sonar.sources points at third_party/matter_sdk/{src,examples}; submodule
                    // must be present in the workspace for sonar-scanner.
                    withCredentials([usernamePassword(credentialsId: 'Matter-Extension-GitHub', usernameVariable: 'GITHUB_APP', passwordVariable: 'GITHUB_ACCESS_TOKEN')]) {
                        sh '''
                            git -c credential.helper='!f() { [ -n "$GITHUB_ACCESS_TOKEN" ] && { echo "username=x-access-token"; echo "password=$GITHUB_ACCESS_TOKEN"; }; }; f' \
                                submodule update --init third_party/matter_sdk
                            test -d third_party/matter_sdk/src
                            test -d third_party/matter_sdk/examples
                        '''
                    }

                    withCredentials([string(credentialsId: sonarqubeTokenCredentialId, variable: 'SONAR_TOKEN')]) {
                        sh '''
                            docker run --rm \
                                -e SONAR_HOST_URL="https://sonarqube.silabs.net" \
                                -e SONAR_TOKEN="$SONAR_TOKEN" \
                                -v "$WORKSPACE:/usr/src" \
                                sonarsource/sonar-scanner-cli:11 \
                                -Dsonar.scm.disabled=true \
                                -Dsonar.coverageReportPaths=coverage/sonarqube-coverage.xml
                        '''
                    }
                }
            }
        }
    }
}
