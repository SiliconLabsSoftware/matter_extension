#!groovy
@Library('gsdk-shared-lib@master')

def build_description = ""

pipeline
{
    agent { node { label 'Build-Farm-Large' } }
    options { buildDiscarder(logRotator(artifactNumToKeepStr: '10')) }
    stages {
        stage('Initialize') {
            steps {
                script {
                    pipelineFunctions = load 'jenkins_integration/jenkinsFunctions.groovy'
                    echo "pipelineFunctions loaded: ${pipelineFunctions != null}"
                    sisdk_build_number = sh(script: "git config -f .gitmodules --get submodule.third_party/simplicity_sdk.tag | sed 's/.*-//'", returnStdout: true).trim()
                    wiseconnect_build_number = sh(script: "git config -f .gitmodules --get submodule.third_party/wifi_sdk.tag | sed 's/.*-//'", returnStdout: true).trim()
                    build_description = "SISDK build number: ${sisdk_build_number}"
                    build_description += "\nWiFi Extension build number: ${wiseconnect_build_number}"
                    buildDescription(build_description)
                }
            }
        }
        stage('Create and Publish Matter Packages') {
            // SiliconLabsInternal/action-conan-create-publish@v2.5.4 via uv
            // v2.5.4 writes conan_package_output.json for Jenkins (set_script_output)
            when {
                expression { env.BRANCH_NAME == 'test/package-upload-jenkins' }
            }
            steps {
                script {
                    def remoteName = 'matter-conan-dev'
                    def remoteUrl = 'https://artifactory-local.silabs.net/artifactory/api/conan/matter-conan-dev'
                    def actionDir = "${env.WORKSPACE}/action-conan-create-publish"
                    def qualifier = 'test'

                    pipelineFunctions.checkoutGithubActionRepo(
                        'action-conan-create-publish',
                        'https://github.com/SiliconLabsInternal/action-conan-create-publish.git',
                        'refs/tags/v2.5.4'
                    )

                    withCredentials([
                        string(credentialsId: 'artifactory_token', variable: 'ARTIFACTORY_TOKEN')
                    ]) {
                        pipelineFunctions.initMatterPackageSubmodules()
                        pipelineFunctions.setupUv()
                        pipelineFunctions.setupSltAndConan()
                        pipelineFunctions.writePrereleaseLabel(qualifier)

                        def refs = []
                        [
                            [name: 'matter',     recipe: "${env.WORKSPACE}/packages/matter/conanfile.py"],
                            [name: 'matter_app', recipe: "${env.WORKSPACE}/packages/matter_app/conanfile.py"],
                        ].each { pkg ->
                            pipelineFunctions.runActionConanCreatePublish(
                                pkg.name, pkg.recipe, remoteName, remoteUrl, actionDir
                            )
                            def pkgInfo = pipelineFunctions.readConanPackageOutputJson()
                            def fullRef = pkgInfo.full_package_ref
                            if (!fullRef) {
                                error("full_package_ref missing from conan_package_output.json for ${pkg.name}")
                            }
                            refs << fullRef
                            echo "Captured full_package_ref for ${pkg.name}: ${fullRef}"

                            // Share prerelease number with matter_app so versions match
                            if (!env.SL_PRERELEASE_NUMBER?.trim() && pkgInfo.prerelease_number) {
                                env.SL_PRERELEASE_NUMBER = pkgInfo.prerelease_number.toString()
                                echo "SL_PRERELEASE_NUMBER=${env.SL_PRERELEASE_NUMBER}"
                            }
                        }

                        env.MATTER_PACKAGE_REF = refs.join(' ')
                        echo "MATTER_PACKAGE_REF=${env.MATTER_PACKAGE_REF}"
                    }
                }
            }
        }
        stage('Promote Matter Packages to SQA') {
            // SiliconLabsInternal/action-conan-promote@v2 via uv + JFrog CLI
            when {
                expression { env.BRANCH_NAME == 'test/package-upload-jenkins' }
            }
            steps {
                script {
                    def sourceRemoteUrl = 'https://artifactory-local.silabs.net/artifactory/api/conan/matter-conan-dev'
                    def destRemoteUrl = 'https://artifactory-local.silabs.net/artifactory/api/conan/matter-conan-sqa'
                    def packageRef = env.MATTER_PACKAGE_REF
                    if (!packageRef) {
                        error('MATTER_PACKAGE_REF is empty; create/publish stage must set full package refs')
                    }

                    pipelineFunctions.checkoutGithubActionRepo(
                        'action-conan-promote',
                        'https://github.com/SiliconLabsInternal/action-conan-promote.git',
                        '*/v2'
                    )

                    withCredentials([
                        string(credentialsId: 'artifactory_token', variable: 'ARTIFACTORY_TOKEN')
                    ]) {
                        pipelineFunctions.runActionConanPromote(
                            packageRef,
                            sourceRemoteUrl,
                            destRemoteUrl,
                            "${env.WORKSPACE}/action-conan-promote"
                        )
                    }
                }
            }
        }
    }
}
