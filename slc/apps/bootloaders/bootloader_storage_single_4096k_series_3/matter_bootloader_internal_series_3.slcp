project_name: matter_bootloader_internal_series_3
package: matter
quality: production
label: Matter - SoC Bootloader Internal Storage Series 3
description: Demonstrates a bootloader configuration using internal storage for Matter firmware updates on Series 3 devices
category: Matter Application
sdk_extension:
  - id: matter
    version: "2.9.1"
    vendor: silabs

component:
  - id: btl_core
  - id: btl_crc
  - id: btl_internal_storage
  - id: btl_storage_slots
  - id: btl_image_parser
  - id: btl_common_storage
  - id: bootloader_aes_sha_ecdsa
  - id: bootloader_debug
  - id: bootloader_compression_lzma
  - id: bootloader_gbl_compression_lz4
  - id: clock_manager

configuration:
  - name: SLOT0_ENABLE
    value: 1

# Slot layout from device_has_<N>kb_flash (host-visible flash, not OPN).

# 3MB class (2880 kB host-visible)
  - name: SLOT0_SIZE
    value: 1208320
    condition: [device_has_2880kb_flash]
  - name: SLOT0_START
    value: 0x01168000
    condition: [device_has_2880kb_flash]
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 0x01168000
    condition: [device_has_2880kb_flash]

# 4MB class (default for other Series 3 sizes until they get a dedicated layout)
  - name: SLOT0_SIZE
    value: 1576960
    unless: [device_has_2880kb_flash, device_has_8000kb_flash]
  - name: SLOT0_START
    value: 0x011F8000
    unless: [device_has_2880kb_flash, device_has_8000kb_flash]
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 0x011F8000
    unless: [device_has_2880kb_flash, device_has_8000kb_flash]

# 8MB class (e.g. simg301m104xil_8mb)
  - name: SLOT0_SIZE
    value: 2732032
    condition: [device_has_8000kb_flash]
  - name: SLOT0_START
    value: 0x01378000
    condition: [device_has_8000kb_flash]
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 0x01378000
    condition: [device_has_8000kb_flash]

filter:
  - name: Type
    value:
      - SoC Project
  - name: Difficulty
    value:
      - Advanced
  - name: Wireless Technology
    value:
      - Matter

tag:
  - prebuilt_demo
  - hwfilter:device:device_series_3
  - hidden

readme:
  - path: ./readme.md
ui_hints:
  highlight:
    - path: readme.md
      focus: false
post_build:
  profile: bootloader_series_2
