workspace_name: generator_firmware_trustzone
label: Matter Generator Firmware - TrustZone
description: >
    Workspace to build the TrustZone enabled Matter Generator Firmware and accompanying bootloader.
quality: production
package: matter
project:
  - path: ./generator_firmware_trustzone_s.slcp
    id: trustzone-secure
    output: generator_firmware_secure
  - path: ./generator_firmware_trustzone_ns.slcp
    id: application
    output: generator_firmware_nonsecure
  - path: ../../bootloaders/bootloader_storage_internal_single_series_2/matter_bootloader_internal_series_2.slcp
    id: bootloader
    output: matter_bootloader
post_build:
  path: ../../../postbuild/ws_trustzone_series2_workspace.slpb
