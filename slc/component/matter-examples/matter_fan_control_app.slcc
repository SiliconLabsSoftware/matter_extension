category: Matter|Examples
package: matter
description: >
  Provides example component for a Fan control application. This component should be 
  included in all Fan control applications to help resolve SLC dependencies. Only applicable to Fan control applications.
id: matter_fan_control_app
quality: production
provides:
  - name: matter_fan_control_app
metadata:
  sbom:
    license: "Apache 2.0"
template_file:
  - path: third_party/matter_sdk/examples/fan-control-app/silabs/include/AppTask.h
  - path: third_party/matter_sdk/examples/fan-control-app/silabs/src/AppTask.cpp
config_file:
  - path: third_party/matter_sdk/examples/fan-control-app/silabs/data_model/fan-control-wifi-app.zap
    directory: common
    file_id: zap_config
    condition: [matter_wifi]
  - path: third_party/matter_sdk/examples/fan-control-app/silabs/data_model/fan-control-thread-app.zap
    directory: common
    file_id: zap_config
    condition: [matter_thread]
include:
  - path: third_party/matter_sdk/examples/fan-control-app/silabs/include
    file_list:
      - path: AppConfig.h
      - path: AppEvent.h
      - path: CHIPProjectConfig.h
      - path: FanControlManager.h
source:
  - path: third_party/matter_sdk/examples/platform/silabs/main.cpp
  - path: third_party/matter_sdk/examples/fan-control-app/silabs/src/FanControlManager.cpp
  - path: third_party/matter_sdk/examples/fan-control-app/silabs/src/DataModelCallbacks.cpp
ui_hints:
  visibility: never
