category: Matter|Examples
package: matter
description: >
  Provides example component for a Multi-Sensor application. This component should be 
  included in all Multi-Sensor applications to help resolve SLC dependencies. Only applicable to Multi-Sensor applications.
id: matter_multi_sensor_app
quality: production
provides:
  - name: matter_multi_sensor_app
metadata:
  sbom:
    license: "Apache 2.0"
template_file:
  - path: third_party/matter_sdk/examples/multi-sensor-app/silabs/include/AppTask.h
  - path: third_party/matter_sdk/examples/multi-sensor-app/silabs/src/AppTask.cpp
config_file:
  - path: third_party/matter_sdk/examples/multi-sensor-app/silabs/data_model/multi-sensor-wifi-app.zap
    directory: common
    file_id: zap_config
    condition: [matter_wifi]
  - path: third_party/matter_sdk/examples/multi-sensor-app/silabs/data_model/multi-sensor-thread-app.zap
    directory: common
    file_id: zap_config
    condition: [matter_thread]
include:
  - path: third_party/matter_sdk/examples/multi-sensor-app/silabs/include
    file_list:
      - path: AppConfig.h
      - path: AppEvent.h
      - path: CHIPProjectConfig.h
      - path: SensorManager.h
source:
  - path: third_party/matter_sdk/examples/platform/silabs/main.cpp
  - path: third_party/matter_sdk/examples/multi-sensor-app/silabs/src/SensorManager.cpp
  - path: third_party/matter_sdk/examples/multi-sensor-app/silabs/src/DataModelCallbacks.cpp
ui_hints:
  visibility: never
