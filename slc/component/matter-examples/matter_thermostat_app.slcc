category: Matter|Examples
package: matter
description: >
  Provides example component for a Thermostat application. This component should be 
  included in all Thermostat applications to help resolve SLC dependencies. Only applicable to Thermostat applications.
id: matter_thermostat_app
quality: production
provides:
  - name: matter_thermostat_app
define:
  - name: IS_DEMO_THERMOSTAT
    value: "1"
metadata:
  sbom:
    license: "Apache 2.0"
template_file:
  - path: third_party/matter_sdk/examples/thermostat/silabs/include/AppTask.h
  - path: third_party/matter_sdk/examples/thermostat/silabs/include/AppTaskImpl.h
  - path: third_party/matter_sdk/examples/thermostat/silabs/src/AppTask.cpp
config_file:
  - path: third_party/matter_sdk/examples/thermostat/silabs/include/ThermostatConfig.h
    file_id: thermostat_config
  - path: third_party/matter_sdk/examples/thermostat/silabs/data_model/thermostat-wifi-app.zap
    directory: common
    file_id: zap_config
    condition: [matter_wifi]
  - path: third_party/matter_sdk/examples/thermostat/silabs/data_model/thermostat-thread-app.zap
    directory: common
    file_id: zap_config
    condition: [matter_thread]
    unless: [matter_zigbee_multiprotocol_common]
include:
  - path: third_party/matter_sdk/examples/thermostat/silabs/include
    file_list:
      - path: AppConfig.h
      - path: AppEvent.h
      - path: CHIPProjectConfig.h
      - path: ThermostatConfig.h
  - path: third_party/matter_sdk/examples/platform/silabs/customer
    file_list:
      - path: CustomerAppTask.h
  - path: third_party/matter_sdk/examples/thermostat/thermostat-common/include
    file_list:
      - path: thermostat-delegate-impl.h
source:
  - path: third_party/matter_sdk/examples/platform/silabs/customer/CustomerAppTask.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/main.cpp
  - path: third_party/matter_sdk/examples/thermostat/thermostat-common/src/thermostat-delegate-impl.cpp
ui_hints:
  visibility: never
