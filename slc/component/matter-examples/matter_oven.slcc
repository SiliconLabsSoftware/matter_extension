category: Matter|Examples
package: matter
description: >
  Provides example component for a Oven application. This component should be 
  included in all oven applications to help resolve SLC dependencies. Only applicable to oven applications.
id: matter_oven
quality: production
provides:
  - name: matter_oven
metadata:
  sbom:
    license: "Apache 2.0"
template_file:
  - path: third_party/matter_sdk/examples/oven-app/silabs/include/AppTask.h
  - path: third_party/matter_sdk/examples/oven-app/silabs/src/AppTask.cpp
config_file:
  - path: third_party/matter_sdk/examples/oven-app/silabs/data_model/oven-wifi-app.zap
    directory: common
    file_id: zap_config
include:
  - path: third_party/matter_sdk/examples/oven-app/silabs/include
    file_list:
      - path: AppConfig.h
      - path: AppEvent.h
      - path: CHIPProjectConfig.h
      - path: OvenManager.h
      - path: AppSupportedTemperatureLevelsDelegate.h
      - path: OvenBindingHandler.h
  - path: third_party/matter_sdk/examples/oven-app/oven-app-common/include
    file_list:
      - path: CookEndpoints.h
      - path: OvenEndpoint.h
source:
  - path: third_party/matter_sdk/examples/platform/silabs/main.cpp
  - path: third_party/matter_sdk/examples/oven-app/silabs/src/OvenManager.cpp
  - path: third_party/matter_sdk/examples/oven-app/silabs/src/DataModelCallbacks.cpp
  - path: third_party/matter_sdk/examples/oven-app/silabs/src/OvenBindingHandler.cpp
  - path: third_party/matter_sdk/examples/oven-app/silabs/src/AppSupportedTemperatureLevelsDelegate.cpp
  - path: third_party/matter_sdk/examples/oven-app/oven-app-common/src/CookEndpoints.cpp
  - path: third_party/matter_sdk/examples/oven-app/oven-app-common/src/OvenEndpoint.cpp
ui_hints:
  visibility: never
