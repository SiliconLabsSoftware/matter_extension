category: Matter|Examples
package: matter
description: >
  Provides example component for a Window application. This component should be 
  included in all Window applications to help resolve SLC dependencies. Only applicable to Window applications.
id: matter_window
quality: production
provides:
  - name: matter_window
metadata:
  sbom:
    license: "Apache 2.0"
template_file:
  - path: third_party/matter_sdk/examples/window-app/silabs/include/AppTask.h
  - path: third_party/matter_sdk/examples/window-app/silabs/src/AppTask.cpp
config_file:
  - path: third_party/matter_sdk/examples/window-app/common/window-app.zap
    directory: common
    file_id: zap_config
include:
  - path: third_party/matter_sdk/examples/window-app/silabs/include
    file_list:
      - path: AppConfig.h
      - path: AppEvent.h
      - path: CHIPProjectConfig.h
source:
  - path: third_party/matter_sdk/examples/platform/silabs/main.cpp
  - path: third_party/matter_sdk/examples/window-app/silabs/src/WindowManager.cpp
  - path: third_party/matter_sdk/examples/window-app/silabs/src/DataModelCallbacks.cpp
ui_hints:
  visibility: never
