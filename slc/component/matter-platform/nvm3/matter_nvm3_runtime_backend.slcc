id: matter_nvm3_runtime_backend
label: NVM3 Runtime Backend
description: >
  This is used to provide nvm3_default_backend without pulling in nvm3_default_flash_backend and (nvm3_default_common_linker.c).
  This is used for situation where NVM3 instance placement is done at runtime.
package: matter
category: Matter|Platform|Provision
quality: production
metadata:
  sbom:
    license: Zlib
provides:
  - name: nvm3_default_backend
requires:
  # Currently only used for Series 2 devices.
  # It could be used in the future for other series
  - name: device_series_2
