id: matter_uart
label: Matter UART
description: Enables sources and defines for UART as used by Matter components
package: matter
category: Platform|UART
quality: production
metadata:
  sbom:
    license: Zlib

requires:
  - name: uartdrv_eusart
    condition:
      - matter_platform_mg
  - name: si91x_debug
    condition:
      - matter_platform_siwx917
  # Official SL ULP UART driver (sl_si91x_usart_* async/DMA APIs) for SiWx917 shell/console.
  - name: sl_ulp_uart
    condition:
      - matter_platform_siwx917

provides:
  - name: matter_uart
  - name: ot_uart_implementation
  - name: matter_uart_interface

conflicts:
  - name: matter_cpc

source:
  - path: third_party/matter_sdk/examples/platform/silabs/uart.cpp

include:
  - path: third_party/matter_sdk/examples/platform/silabs
    file_list:
      - path: uart.h

define:
  - name: CONFIG_ENABLE_EUART
    condition:
      - matter_platform_mg
  - name: EFR32MG24
    condition:
      - device_family_efr32mg24
      - matter_platform_mg
  - name: MGM24
    condition:
      - device_family_mgm24
      - matter_platform_mg
  - name: SLI_SI91X_MCU_INTR_BASED_RX_ON_UART
    value: 1
    condition: [matter_platform_siwx917]

# Matter owns ULP_UART via sl_si91x_usart_*. Pulling in sl_ulp_uart disables
# DEBUG_UART in si91x_debug (SDK unless: [sl_ulp_uart]), so Board_Debug_Init never
# runs. uartEarlyInit() is also invoked from uartConsoleInit() when this hook is absent.
template_contribution:
  - name: event_handler
    condition: [matter_platform_siwx917]
    priority: -9993
    value:
      event: platform_init
      include: uart.h
      handler: uartEarlyInit
