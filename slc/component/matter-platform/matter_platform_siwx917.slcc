id: matter_platform_siwx917
label: Platform for SiWx917
description: SiWx917 platform support for Matter
package: matter
category: "Matter-WiFi|Platform"
quality: production
metadata:
  sbom:
    license: Zlib
config_file:
  - path: third_party/matter_sdk/src/lwip/silabs/config/lwipopts.h
    override:
      component: "wifi_resources"
      file_id: lwipopts
      vendor: silabs

requires:
  - name: sl_main
  - name: matter_siwx917
  - name: matter_siwx917_common
  - name: sl_si91x_trng
  - name: nvm3_default
  - name: freertos_heap_3
  - name: psram_core
    condition: [device_supports_psram, device_supports_external_flash]
  - name: syscalls

provides:
  - name: matter_platform_siwx917
  - name: matter_si91x_common_flash_nvm3_enabled

include:
  - path: third_party/matter_sdk/examples/platform/silabs
    file_list:
      - path: PigweedLogger.h
      - path: Rpc.h
      - path: silabs_utils.h
      - path: LEDWidget.h
      - path: MatterConfig.h
      - path: OTAConfig.h
      - path: MemMonitoring.h
      - path: BaseApplication.h
      - path: BaseAppEvent.h
      - path: SoftwareFaultReports.h
source:
  - path: third_party/matter_sdk/examples/platform/silabs/BaseApplication.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/silabs_utils.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/MatterConfig.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/SoftwareFaultReports.cpp
define:
  - name: SUPPORT_CPLUSPLUS
    value: 1
  - name: SL_MATTER_SIWX_WIFI_ENABLE
  - name: SL_SI91x_DUAL_INTERRUPTS_ERRATA
  - name: NVM3_LOCK_OVERRIDE
  #TODO: Replace the SLI macros with SL macros after SI91X-22662 is resolved
  # Wi-Fi sli_buffer_manager pool sizes (override WiseConnect defaults for Matter SoC RAM Optimization).
  - name: SLI_BUFFER_MANAGER_CE_CMD_TX_POOL_BLOCK_COUNT
    value: 3
  - name: SLI_BUFFER_MANAGER_DATA_TX_POOL_BLOCK_COUNT
    value: 3
  - name: SLI_BUFFER_MANAGER_HAL_CMD_DATA_RX_POOL_BLOCK_COUNT
    value: 5
  - name: SLI_BUFFER_MANAGER_HAL_CMD_DATA_RX_POOL_UART_BLOCK_COUNT
    value: 10
  - name: SLI_BUFFER_MANAGER_QUEUE_NODE_POOL_BLOCK_COUNT
    value: 20
  - name: SLI_BUFFER_MANAGER_COMMON_POOL_BLOCK_COUNT
    value: 1
toolchain_settings:
  - option: gcc_linker_option
    value: "-Wl,--wrap=MemoryAlloc"
    # Wrap these in case internal newlib call them (e.g. strdup will)
    # directly call _malloc_r)
  - option: gcc_compiler_option
    value: "-Wno-cpp"
    unless: [hardware_board]
