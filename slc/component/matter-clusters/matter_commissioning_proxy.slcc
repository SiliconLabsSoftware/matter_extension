category: Clusters|Network Infrastructure
description: >
  Implementation of the Commissioning Proxy Server Cluster.
  The user has to enable the Commissioning Proxy Server Cluster in the ZCL Advanced Platform (ZAP) tool in order to enable this functionality.
id: matter_commissioning_proxy
package: matter
label: Commissioning Proxy Server Cluster
quality: production
metadata:
  sbom:
    license: "Apache 2.0"
provides:
  - name: matter_commissioning_proxy
source:
  - path: third_party/matter_sdk/src/app/clusters/commissioning-proxy-server/CodegenIntegration.cpp
    unless: [matter_code_driven_dm]
  - path: third_party/matter_sdk/src/app/clusters/commissioning-proxy-server/CommissioningProxyBgScanRegistry.cpp
  - path: third_party/matter_sdk/src/app/clusters/commissioning-proxy-server/CommissioningProxyBleTransport.cpp
  - path: third_party/matter_sdk/src/app/clusters/commissioning-proxy-server/CommissioningProxyCluster.cpp
  - path: third_party/matter_sdk/src/app/clusters/commissioning-proxy-server/CommissioningProxyScanAggregator.cpp
  - path: third_party/matter_sdk/src/app/clusters/commissioning-proxy-server/CommissioningProxyScanCache.cpp
  - path: third_party/matter_sdk/src/app/clusters/commissioning-proxy-server/CommissioningProxySessionManager.cpp
include:
  - path: third_party/matter_sdk/src/app/clusters/commissioning-proxy-server
    file_list:
      - path: CodegenIntegration.h
        unless: [matter_code_driven_dm]
      - path: CommissioningProxyBgScanRegistry.h
      - path: CommissioningProxyBleAdapter.h
      - path: CommissioningProxyBleTransport.h
      - path: CommissioningProxyCluster.h
      - path: CommissioningProxyScanAggregator.h
      - path: CommissioningProxyScanCache.h
      - path: CommissioningProxySessionManager.h
      - path: CommissioningProxyTestEventTriggerHandler.h
      - path: CommissioningProxyTransport.h
template_contribution:
  - name: component_catalog
    value: matter_commissioning_proxy