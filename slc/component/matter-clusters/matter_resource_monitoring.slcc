category: Clusters|Measurement
description: >
  Implementation of the Resource Monitoring Server Cluster, used via aliases for HEPA Filter, Activated Carbon Filter, and Water Tank Level Monitoring.
  The user has to enable one or more of these aliased clusters in the ZCL Advanced Platform (ZAP) tool in order to enable this functionality.
id: matter_resource_monitoring
package: matter
label: Resource Monitoring Server Cluster
quality: production
metadata:
  sbom:
    license: "Apache 2.0"
provides:
  - name: matter_resource_monitoring
source:
  - path: third_party/matter_sdk/src/app/clusters/resource-monitoring-server/CodegenIntegration.cpp
    unless: [matter_code_driven_dm]
  - path: third_party/matter_sdk/src/app/clusters/resource-monitoring-server/CodegenResourceMonitoringCluster.cpp
  - path: third_party/matter_sdk/src/app/clusters/resource-monitoring-server/MigrateResourceMonitoringServerStorage.cpp
  - path: third_party/matter_sdk/src/app/clusters/resource-monitoring-server/resource-monitoring-cluster-objects.cpp
  - path: third_party/matter_sdk/src/app/clusters/resource-monitoring-server/ResourceMonitoringCluster.cpp
include:
  - path: third_party/matter_sdk/src/app/clusters/resource-monitoring-server
    file_list:
      - path: CodegenIntegration.h
        unless: [matter_code_driven_dm]
      - path: CodegenResourceMonitoringCluster.h
      - path: MigrateResourceMonitoringServerStorage.h
      - path: replacement-product-list-manager.h
      - path: resource-monitoring-cluster-objects.h
      - path: resource-monitoring-server.h
      - path: ResourceMonitoringCluster.h
      - path: ResourceMonitoringDelegate.h
template_contribution:
  - name: component_catalog
    value: matter_resource_monitoring