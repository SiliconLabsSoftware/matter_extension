category: Clusters|General
description: >
  Implementation of the Groups Server Cluster.
  The user has to enable the Groups Server Cluster in the ZCL Advanced Platform (ZAP) tool in order to enable this functionality.
id: matter_groups
package: matter
label: Groups Server Cluster
quality: production
metadata:
  sbom:
    license: "Apache 2.0"
provides:
  - name: matter_groups
requires:
  - name: matter_scenes_support
source:
  - path: third_party/matter_sdk/src/app/clusters/groups-server/CodegenIntegration.cpp
    unless: [matter_code_driven_dm]
  - path: third_party/matter_sdk/src/app/clusters/groups-server/GroupsClusterImpl.cpp
    unless: [matter_groupcast]
  - path: third_party/matter_sdk/src/app/clusters/groups-server/StubbedGroupsCluster.cpp
    condition: [matter_groupcast]
include:
  - path: third_party/matter_sdk/src/app/clusters/groups-server
    file_list:
      - path: GroupsCluster.h
      - path: GroupsClusterContext.h
      - path: GroupsClusterImpl.h
        unless: [matter_groupcast]
      - path: StubbedGroupsCluster.h
        condition: [matter_groupcast]
template_contribution:
  - name: component_catalog
    value: matter_groups