category: Clusters|Measurement
description: >
  Implementation of the Electrical Alarm Server Cluster.
  The user has to enable the Electrical Alarm Server Cluster in the ZCL Advanced Platform (ZAP) tool in order to enable this functionality.
id: matter_electrical_alarm
package: matter
label: Electrical Alarm Server Cluster
quality: production
metadata:
  sbom:
    license: "Apache 2.0"
provides:
  - name: matter_electrical_alarm
source:
  - path: third_party/matter_sdk/src/app/clusters/electrical-alarm-server/CodegenIntegration.cpp
    unless: [matter_code_driven_dm]
  - path: third_party/matter_sdk/src/app/clusters/electrical-alarm-server/ElectricalAlarmCluster.cpp
include:
  - path: third_party/matter_sdk/src/app/clusters/electrical-alarm-server
    file_list:
      - path: CodegenIntegration.h
        unless: [matter_code_driven_dm]
      - path: electrical-alarm-delegate.h
      - path: ElectricalAlarmCluster.h
      - path: ElectricalAlarmTestEventTriggerHandler.h
template_contribution:
  - name: component_catalog
    value: matter_electrical_alarm