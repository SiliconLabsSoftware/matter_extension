id: matter_mqtt_bridge
package: matter
description: >
  Matter MQTT cluster bridge: maps Matter attribute changes and commands to the Silabs MQTT cloud contract.
  Includes platform demo adapters and DeviceMqttProfile wiring when enabled.
label: Matter MQTT Cluster Bridge
category: Matter-WiFi|Services|MQTT
quality: experimental
metadata:
  sbom:
    license: Apache 2.0

provides:
  - name: matter_mqtt_bridge

requires:
  - name: matter_service_mqtt

define:
  - name: SL_MATTER_ENABLE_MQTT_BRIDGE
    value: "1"
  - name: SL_MATTER_MQTT_BRIDGE_WILDCARD_SUBSCRIBE
    value: "1"
  - name: SL_MATTER_MQTT_BRIDGE_POST_ATTRIBUTE_HOOK
    value: "1"

include:
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/include
    file_list:
      - path: attribute_value_reader.h
      - path: cluster_adapter.h
      - path: command_injector.h
      - path: device_mqtt_profile.h
      - path: matter_mqtt_attribute_listener.h
      - path: matter_mqtt_bridge.h
      - path: matter_mqtt_bridge_config.h
      - path: matter_mqtt_codec.h
      - path: matter_mqtt_contract.h
      - path: matter_mqtt_topic.h
      - path: matter_mqtt_types.h
      - path: matter_mqtt_value_converter.h
      - path: mqtt_transport_port.h
  - path: third_party/matter_sdk/examples/platform/silabs/matter_mqtt_bridge
    file_list:
      - path: MatterMqttBridgeConfig.h

source:
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/attribute_value_reader.cpp
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/command_injector.cpp
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/device_mqtt_profile.cpp
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/matter_mqtt_attribute_listener.cpp
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/matter_mqtt_bridge.cpp
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/matter_mqtt_codec.cpp
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/matter_mqtt_topic.cpp
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/matter_mqtt_value_converter.cpp
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/mqtt_client_transport_port.cpp
  - path: third_party/matter_sdk/src/platform/silabs/services/matter_mqtt_bridge/src/cluster_adapter_registry.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/matter_mqtt_bridge/MatterMqttBridgeConfig.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/matter_mqtt_bridge/MqttAdapterRegistry.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/matter_mqtt_bridge/adapters/DoorLockAdapter.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/matter_mqtt_bridge/adapters/OnOffAdapter.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/matter_mqtt_bridge/adapters/ThermostatAdapter.cpp
  - path: third_party/matter_sdk/examples/platform/silabs/matter_mqtt_bridge/adapters/WindowCoveringAdapter.cpp
