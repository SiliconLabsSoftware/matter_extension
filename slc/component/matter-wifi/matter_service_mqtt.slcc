id: matter_service_mqtt
package: matter
description: >
  Matter MQTT service for Wi-Fi platforms.
label: Matter MQTT Service
category: Matter-WiFi|Services|MQTT
quality: production
metadata:
  sbom:
    license: Zlib

provides:
  - name: matter_service_mqtt

requires:
  - name: matter_services

include:
  - path: third_party/matter_sdk/src/platform/silabs/services
    file_list:
      - path: mqtt_client.h

source:
  - path: third_party/matter_sdk/src/platform/silabs/services/mqtt_client.c

define:
  - name: SLI_PAHO_MQTT_OVER_LWIP
  - name: MQTT_USE_HOST_LWIP_TLS
    value: "1"
  - name: SL_MATTER_ENABLE_MQTT_SERVICE
    value: "1"
